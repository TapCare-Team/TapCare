# Database mode is the default and requires a non-empty DATABASE_URL.
DATABASE_URL="postgresql://tapcare:tapcare@localhost:5432/tapcare?schema=public"

# Optional local development and test mode only. Never use this on Vercel.
# TAPCARE_DATA_MODE="mock"

# Required for hosted auth callback and email links.
APP_BASE_URL="http://localhost:3000"

# Permanent public base URL written to physical NFC tags. Never use a Vercel preview URL.
PUBLIC_STICKER_BASE_URL="http://localhost:3000"

# Password reset email delivery via Resend.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="TapCare <noreply@example.com>"

# Google sign-in.
# Redirect URI in Google Cloud Console:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Upstash Redis coordination state. PostgreSQL remains the source of truth.
# Redis is only used for short-lived rate limits and deduplication; a Redis flush
# must not remove users, sessions, permissions, stickers, event history, or follow-up state.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
